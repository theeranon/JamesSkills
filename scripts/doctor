#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="$(tr -d '[:space:]' < "$repo_dir/VERSION")"
commit="uncommitted"
if git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
  commit="$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo uncommitted)"
fi

echo "JamesSkills version=$version commit=$commit"
"$repo_dir/scripts/validate"

hooks_path="$(git -C "$repo_dir" config --get core.hooksPath 2>/dev/null || true)"
if [[ "$hooks_path" == ".githooks" ]]; then
  echo "Git gates=pre-commit,pre-push"
else
  echo "Git gates=NOT INSTALLED"
fi

for target in "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.gemini/config/skills"; do
  [[ -d "$target" ]] || continue
  linked=0
  broken=0
  while IFS= read -r skill_dir; do
    name="$(basename "$skill_dir")"
    link="$target/$name"
    [[ -L "$link" ]] && linked=$((linked + 1))
    [[ -L "$link" && ! -e "$link" ]] && broken=$((broken + 1))
  done < <(find "$repo_dir/skills/core" -mindepth 1 -maxdepth 1 -type d | sort)
  echo "$target linked=$linked broken=$broken"
done
