#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="$(tr -d '[:space:]' < "$repo_dir/VERSION")"
commit="uncommitted"
if git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
  commit="$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo uncommitted)"
fi

echo "JamesSkills version=$version commit=$commit"
"$repo_dir/scripts/validate"

hooks_path="$(git -C "$repo_dir" config --get core.hooksPath 2>/dev/null || true)"
if [[ "$hooks_path" == ".githooks" ]]; then
  echo "Git gates=pre-commit,pre-push"
else
  echo "Git gates=NOT INSTALLED"
fi

for target in "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.gemini/config/skills"; do
  [[ -d "$target" ]] || continue
  linked=0
  broken=0
  while IFS=$'\t' read -r category name; do
    skill_dir="$repo_dir/skills/$category/$name"
    link="$target/$name"
    [[ -L "$link" ]] && linked=$((linked + 1))
    [[ -L "$link" && ! -e "$link" ]] && broken=$((broken + 1))
  done < <(python3 - "$repo_dir/catalog.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["skills"]:
    if item["status"] == "promoted":
        print(f'{item["category"]}\t{item["name"]}')
PY
)

  aliases=0
  while IFS=$'\t' read -r alias_name canonical_name; do
    [[ -n "$alias_name" && -n "$canonical_name" ]] || continue
    link="$target/$alias_name"
    [[ -L "$link" ]] && aliases=$((aliases + 1))
    [[ -L "$link" && ! -e "$link" ]] && broken=$((broken + 1))
  done < <(python3 - "$repo_dir/catalog.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["skills"]:
    if item["status"] == "promoted":
        for alias in item.get("aliases", []):
            print(f'{alias}\t{item["name"]}')
PY
)

  echo "$target canonical=$linked aliases=$aliases broken=$broken"
done
