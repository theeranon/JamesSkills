#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="$(tr -d '[:space:]' < "$repo_dir/VERSION")"
commit="uncommitted"
dirty="unknown"
if git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
  commit="$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo uncommitted)"
  if [[ -z "$(git -C "$repo_dir" status --porcelain)" ]]; then
    dirty="no"
  else
    dirty="yes"
  fi
fi

echo "JamesSkills version=$version commit=$commit dirty=$dirty source=$repo_dir"
"$repo_dir/scripts/validate"

claude_uses_plugins=0
if [[ -f "$HOME/.claude/plugins/installed_plugins.json" ]] \
  && grep -q '@james-skills' "$HOME/.claude/plugins/installed_plugins.json"; then
  claude_uses_plugins=1
fi

codex_uses_plugins=0
if [[ -f "$HOME/.codex/config.toml" ]] \
  && grep -q '@james-skills' "$HOME/.codex/config.toml"; then
  codex_uses_plugins=1
fi

promoted_names="$(python3 - "$repo_dir/catalog.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["skills"]:
    if item["status"] == "promoted":
        print(item["name"])
        print(*item.get("aliases", []), sep="\n")
PY
)"
issues=0

hooks_path="$(git -C "$repo_dir" config --get core.hooksPath 2>/dev/null || true)"
if [[ "$hooks_path" == ".githooks" ]]; then
  echo "Git gates=pre-commit,pre-push"
else
  echo "Git gates=NOT INSTALLED"
fi

for target in \
  "$HOME/.agents/skills" \
  "$HOME/.codex/skills" \
  "$HOME/.claude/skills" \
  "$HOME/.cursor/skills" \
  "$HOME/.gemini/config/skills" \
  "$HOME/.gemini/antigravity/custom/skills"; do
  [[ -d "$target" ]] || continue
  base_dir="$(dirname "$target")"

  if [[ "$target" == "$HOME/.claude/skills" && "$claude_uses_plugins" -eq 1 ]] \
    || [[ "$target" == "$HOME/.codex/skills" && "$codex_uses_plugins" -eq 1 ]]; then
    if [[ "$target" == "$HOME/.claude/skills" ]]; then
      manifest="$HOME/.claude/plugins/installed_plugins.json"
    else
      manifest="$HOME/.codex/config.toml"
    fi
    plugin_count=0
    for plugin in "$repo_dir/plugins/"*; do
      [[ -d "$plugin" ]] || continue
      grep -q "$(basename "$plugin")@james-skills" "$manifest" \
        && plugin_count=$((plugin_count + 1))
    done
    stray=0
    while IFS= read -r managed_link; do
      [[ "$(readlink "$managed_link")" == "$repo_dir/plugins/"* ]] && stray=$((stray + 1)) \
        && echo "DUPLICATE canonical link shadows an installed plugin: $managed_link"
    done < <(find "$target" -mindepth 1 -maxdepth 1 -type l | sort)
    alias_count=0
    for alias_dir in "$repo_dir/aliases/"*; do
      [[ -d "$alias_dir" ]] || continue
      [[ -L "$target/$(basename "$alias_dir")" ]] && alias_count=$((alias_count + 1))
    done
    echo "$target via plugins=$plugin_count aliases=$alias_count duplicates=$stray"
    issues=$((issues + stray))
    continue
  fi

  if [[ "$base_dir" == *".gemini"* ]]; then
    plugin_missing=0
    plugin_wrong=0
    plugin_linked=0
    for plugin in "$repo_dir/plugins/"*; do
      [[ -d "$plugin" ]] || continue
      plugin_name="$(basename "$plugin")"
      plugin_link="$base_dir/plugins/$plugin_name"
      if [[ ! -L "$plugin_link" ]]; then
        plugin_missing=$((plugin_missing + 1))
        echo "MISSING plugin link: $plugin_link"
      elif [[ "$(readlink "$plugin_link")" != "$plugin" ]]; then
        plugin_wrong=$((plugin_wrong + 1))
        echo "WRONG TARGET plugin link: $plugin_link -> $(readlink "$plugin_link")"
      else
        plugin_linked=$((plugin_linked + 1))
      fi
    done
    alias_count=0
    for alias_dir in "$repo_dir/aliases/"*; do
      [[ -d "$alias_dir" ]] || continue
      [[ -L "$target/$(basename "$alias_dir")" ]] && alias_count=$((alias_count + 1))
    done
    echo "$base_dir/plugins plugins=$plugin_linked aliases=$alias_count missing=$plugin_missing wrong_target=$plugin_wrong"
    issues=$((issues + plugin_missing + plugin_wrong))
    continue
  fi

  linked=0
  broken=0
  wrong_target=0
  missing=0
  collisions=0
  while IFS=$'\t' read -r category name; do
    skill_dir="$repo_dir/plugins/$category/skills/$name"
    link="$target/$name"
    [[ -L "$link" ]] && linked=$((linked + 1))
    [[ -L "$link" && ! -e "$link" ]] && broken=$((broken + 1))
    if [[ ! -L "$link" && -e "$link" ]]; then
      collisions=$((collisions + 1))
      echo "COLLISION canonical non-link: $link"
    elif [[ ! -L "$link" ]]; then
      missing=$((missing + 1))
      echo "MISSING canonical link: $link"
    fi
    if [[ -L "$link" && "$(readlink "$link")" != "$skill_dir" ]]; then
      wrong_target=$((wrong_target + 1))
      echo "WRONG target: $link -> $(readlink "$link") expected=$skill_dir"
    fi
  done < <(python3 - "$repo_dir/catalog.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["skills"]:
    if item["status"] == "promoted":
        print(f'{item["category"]}\t{item["name"]}')
PY
)

  aliases=0
  while IFS=$'\t' read -r alias_name canonical_name; do
    [[ -n "$alias_name" && -n "$canonical_name" ]] || continue
    link="$target/$alias_name"
    alias_dir="$repo_dir/aliases/$alias_name"
    [[ -L "$link" ]] && aliases=$((aliases + 1))
    [[ -L "$link" && ! -e "$link" ]] && broken=$((broken + 1))
    if [[ ! -L "$link" && -e "$link" ]]; then
      collisions=$((collisions + 1))
      echo "COLLISION alias non-link: $link"
    elif [[ ! -L "$link" ]]; then
      missing=$((missing + 1))
      echo "MISSING alias link: $link"
    fi
    if [[ -L "$link" && "$(readlink "$link")" != "$alias_dir" ]]; then
      wrong_target=$((wrong_target + 1))
      echo "WRONG alias target: $link -> $(readlink "$link") expected=$alias_dir"
    fi
  done < <(python3 - "$repo_dir/catalog.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["skills"]:
    if item["status"] == "promoted":
        for alias in item.get("aliases", []):
            print(f'{alias}\t{item["name"]}')
PY
)

  unexpected=0
  while IFS= read -r managed_link; do
    linked_path="$(readlink "$managed_link")"
    link_name="$(basename "$managed_link")"
    if [[ "$linked_path" == "$repo_dir/plugins/"* || "$linked_path" == "$repo_dir/aliases/"* ]] && ! grep -Fqx "$link_name" <<<"$promoted_names"; then
      unexpected=$((unexpected + 1))
      echo "UNEXPECTED unpromoted managed link: $managed_link -> $linked_path"
    fi
  done < <(find "$target" -mindepth 1 -maxdepth 1 -type l | sort)

  echo "$target canonical=$linked aliases=$aliases broken=$broken wrong_target=$wrong_target missing=$missing collisions=$collisions unexpected=$unexpected"
  issues=$((issues + broken + wrong_target + missing + collisions + unexpected))
done

if [[ "$issues" -ne 0 ]]; then
  echo "FAIL discovery-link issues=$issues"
  exit 1
fi
