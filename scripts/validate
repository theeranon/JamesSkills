#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
errors=0
count=0

while IFS= read -r skill_file; do
  count=$((count + 1))
  skill_dir="$(dirname "$skill_file")"
  folder_name="$(basename "$skill_dir")"
  name="$(awk '/^name: / {sub(/^name: /, ""); print; exit}' "$skill_file")"
  description="$(awk '/^description: / {sub(/^description: /, ""); print; exit}' "$skill_file")"

  if [[ "$name" != "$folder_name" ]]; then
    echo "FAIL name mismatch: $skill_file ($name != $folder_name)"
    errors=$((errors + 1))
  fi
  if [[ -z "$description" ]]; then
    echo "FAIL missing description: $skill_file"
    errors=$((errors + 1))
  fi
done < <(find "$repo_dir/skills" "$repo_dir/aliases" -name SKILL.md -type f | sort)

if [[ "$count" -eq 0 ]]; then
  echo "FAIL no skills found"
  exit 1
fi
if [[ "$errors" -ne 0 ]]; then
  echo "Validation failed: $errors issue(s)"
  exit 1
fi

python3 "$repo_dir/scripts/check_repository_boundary.py" "$repo_dir"

python3 - "$repo_dir" <<'PY'
import json
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1])
catalog = json.loads((root / "catalog.json").read_text(encoding="utf-8"))
items = catalog.get("skills", [])
if catalog.get("schema_version") != 1 or not items:
    raise SystemExit("FAIL invalid or empty catalog")

names = [item["name"] for item in items]
if len(names) != len(set(names)):
    raise SystemExit("FAIL duplicate canonical skill name in catalog")

allowed_statuses = {"pilot", "promoted"}
invalid_statuses = sorted(
    {item.get("status") for item in items} - allowed_statuses,
    key=lambda value: str(value),
)
if invalid_statuses:
    raise SystemExit(f"FAIL invalid lifecycle status: {invalid_statuses}")

aliases = [alias for item in items for alias in item.get("aliases", [])]
if len(aliases) != len(set(aliases)) or set(aliases) & set(names):
    raise SystemExit("FAIL duplicate alias or alias collides with canonical name")

catalog_paths = set()
for item in items:
    path = root / "plugins" / item["category"] / "skills" / item["name"] / "SKILL.md"
    if not path.is_file():
        raise SystemExit(f"FAIL catalog target missing: {path}")
    catalog_paths.add(path.resolve())

disk_paths = {path.resolve() for path in list((root / "plugins").glob("*/skills/*/SKILL.md")) + list((root / "plugins").glob("*/rules/*/*.md"))}
if disk_paths != catalog_paths:
    missing = sorted(str(path) for path in disk_paths - catalog_paths)
    stale = sorted(str(path) for path in catalog_paths - disk_paths)
    raise SystemExit(f"FAIL catalog mismatch unlisted={missing} missing={stale}")

alias_paths = {path.parent.name: path for path in (root / "aliases").glob("*/SKILL.md")}
if set(alias_paths) != set(aliases):
    raise SystemExit(
        f"FAIL alias package mismatch catalog={sorted(aliases)} disk={sorted(alias_paths)}"
    )
alias_owners = {
    alias: item["name"]
    for item in items
    for alias in item.get("aliases", [])
}
for alias, path in alias_paths.items():
    text = path.read_text(encoding="utf-8")
    alias_kind = "Compatibility Alias" in text or "Lens Shortcut" in text
    if f"name: {alias}" not in text or not alias_kind:
        raise SystemExit(f"FAIL malformed alias package: {path}")
    owner = alias_owners[alias]
    if f"`{owner}`" not in text:
        raise SystemExit(f"FAIL alias does not point to catalog owner: {alias} -> {owner}")

for pack in catalog.get("packs", []):
    path = root / pack["path"]
    if not path.is_file():
        raise SystemExit(f"FAIL catalog pack missing: {path}")

print(f"PASS catalog skills={len(items)} aliases={len(aliases)}")
PY

python3 "$repo_dir/plugins/james-software/skills/project-standard/scripts/project_standard.py" \
  check "$repo_dir" --ready

while IFS= read -r test_file; do
  python3 "$test_file"
done < <(find "$repo_dir/skills" -path '*/tests/test_*.py' -type f | sort)

while IFS= read -r test_file; do
  python3 "$test_file"
done < <(find "$repo_dir/tests" -maxdepth 1 -name 'test_*.py' -type f | sort)

linter="$repo_dir/plugins/james-core/skills/make-it-james/scripts/lint_outcome.py"
if [[ -f "$linter" ]]; then
  while IFS= read -r asset; do
    python3 "$linter" --strict "$asset"
  done < <(find "$repo_dir/skills" -path '*/assets/*.html' -type f | sort)
fi

echo "PASS $count package(s), portable structure and repository boundary gate"
