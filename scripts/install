#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
"$repo_dir/scripts/validate"
"$repo_dir/scripts/install-hooks"

targets=("$HOME/.agents/skills" "$HOME/.codex/skills" "$HOME/.claude/skills")
if [[ -d "$HOME/.gemini/config" ]]; then
  targets+=("$HOME/.gemini/config/skills")
fi
if [[ -d "$HOME/.gemini/antigravity/custom" ]]; then
  targets+=("$HOME/.gemini/antigravity/custom/skills")
fi

promoted_names="$(python3 - "$repo_dir/catalog.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["skills"]:
    if item["status"] == "promoted":
        print(item["name"])
        print(*item.get("aliases", []), sep="\n")
PY
)"

for target in "${targets[@]}"; do
  mkdir -p "$target"
  while IFS= read -r existing_link; do
    linked_path="$(readlink "$existing_link")"
    link_name="$(basename "$existing_link")"
    if [[ "$linked_path" == "$repo_dir/skills/"* || "$linked_path" == "$repo_dir/aliases/"* ]] && ! grep -Fqx "$link_name" <<<"$promoted_names"; then
      unlink "$existing_link"
      echo "PRUNE unpromoted link: $existing_link"
    fi
  done < <(find "$target" -mindepth 1 -maxdepth 1 -type l | sort)
  while IFS=$'\t' read -r category name; do
    skill_dir="$repo_dir/skills/$category/$name"
    link="$target/$name"
    if [[ -L "$link" ]]; then
      ln -sfn "$skill_dir" "$link"
    elif [[ -e "$link" ]]; then
      echo "FAIL existing non-link blocks canonical skill: $link"
      echo "Move that legacy package to a backup location, then rerun install."
      exit 1
    else
      ln -s "$skill_dir" "$link"
    fi
  done < <(python3 - "$repo_dir/catalog.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["skills"]:
    if item["status"] == "promoted":
        print(f'{item["category"]}\t{item["name"]}')
PY
)

  while IFS=$'\t' read -r alias_name category canonical_name; do
    [[ -n "$alias_name" && -n "$canonical_name" ]] || continue
    alias_dir="$repo_dir/aliases/$alias_name"
    if [[ ! -f "$alias_dir/SKILL.md" ]]; then
      echo "FAIL alias target missing: $alias_name -> $canonical_name"
      exit 1
    fi
    alias_link="$target/$alias_name"
    if [[ -L "$alias_link" ]]; then
      ln -sfn "$alias_dir" "$alias_link"
    elif [[ -e "$alias_link" ]]; then
      echo "FAIL existing non-link blocks compatibility alias: $alias_link"
      echo "Move that legacy package to a backup location, then rerun install."
      exit 1
    else
      ln -s "$alias_dir" "$alias_link"
    fi
  done < <(python3 - "$repo_dir/catalog.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["skills"]:
    if item["status"] == "promoted":
        for alias in item.get("aliases", []):
            print(f'{alias}\t{item["category"]}\t{item["name"]}')
PY
)
done

echo "Installed links from $repo_dir"
