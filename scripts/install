#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
"$repo_dir/scripts/validate"
"$repo_dir/scripts/install-hooks"

# Claude Code registers plugins through installed_plugins.json, and Codex CLI
# registers them in config.toml as [plugins."<name>@james-skills"]. When the
# three pillars are installed that way, loose skill links would duplicate
# every skill, so this installer writes only aliases there. Aliases have no
# plugin counterpart, so they never collide.
claude_uses_plugins=0
if [[ -f "$HOME/.claude/plugins/installed_plugins.json" ]] \
  && grep -q '@james-skills' "$HOME/.claude/plugins/installed_plugins.json"; then
  claude_uses_plugins=1
  echo "Claude Code has the james-skills plugins installed; writing aliases only to ~/.claude/skills"
fi

codex_uses_plugins=0
if [[ -f "$HOME/.codex/config.toml" ]] \
  && grep -q '@james-skills' "$HOME/.codex/config.toml"; then
  codex_uses_plugins=1
  echo "Codex CLI has the james-skills plugins installed; writing aliases only to ~/.codex/skills"
fi

targets=("$HOME/.agents/skills" "$HOME/.codex/skills" "$HOME/.claude/skills")
if [[ -d "$HOME/.cursor" ]]; then
  targets+=("$HOME/.cursor/skills")
fi
if [[ -d "$HOME/.gemini/config" ]]; then
  targets+=("$HOME/.gemini/config/skills")
fi
if [[ -d "$HOME/.gemini/antigravity/custom" ]]; then
  targets+=("$HOME/.gemini/antigravity/custom/skills")
fi

promoted_names="$(python3 - "$repo_dir/catalog.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["skills"]:
    if item["status"] == "promoted":
        print(item["name"])
        print(*item.get("aliases", []), sep="\n")
PY
)"

for target in "${targets[@]}"; do
  base_dir="$(dirname "$target")"
  skills_target="$base_dir/skills"
  plugins_target="$base_dir/plugins"
  
  mkdir -p "$skills_target"

  # If this is an Antigravity target, we use the Plugin Architecture
  if [[ "$base_dir" == *".gemini"* ]]; then
    mkdir -p "$plugins_target"
    
    # 1. Clean up legacy standalone skills to prevent double-loading in Antigravity
    while IFS= read -r existing_link; do
      linked_path="$(readlink "$existing_link")"
      if [[ "$linked_path" == "$repo_dir/skills/"* || "$linked_path" == "$repo_dir/plugins/"* ]]; then
        unlink "$existing_link"
      fi
    done < <(find "$skills_target" -mindepth 1 -maxdepth 1 -type l | sort)

    # 2. Symlink the 3 Plugins
    for plugin in "$repo_dir/plugins/"*; do
      if [[ -d "$plugin" ]]; then
        plugin_name="$(basename "$plugin")"
        link="$plugins_target/$plugin_name"
        ln -sfn "$plugin" "$link"
      fi
    done
  elif [[ "$skills_target" == "$HOME/.claude/skills" && "$claude_uses_plugins" -eq 1 ]] \
    || [[ "$skills_target" == "$HOME/.codex/skills" && "$codex_uses_plugins" -eq 1 ]]; then
    # Plugins already provide every canonical skill here. Remove any stale
    # canonical link this repository owns so nothing is loaded twice.
    while IFS= read -r existing_link; do
      linked_path="$(readlink "$existing_link")"
      if [[ "$linked_path" == "$repo_dir/plugins/"* ]]; then
        unlink "$existing_link"
      fi
    done < <(find "$skills_target" -mindepth 1 -maxdepth 1 -type l | sort)
  else
    # Codex, Cursor, and the shared .agents root load individual skills.
    for plugin in "$repo_dir/plugins/"*; do
      if [[ -d "$plugin/skills" ]]; then
        for skill in "$plugin/skills/"*; do
          if [[ -d "$skill" ]]; then
            skill_name="$(basename "$skill")"
            link="$skills_target/$skill_name"
            ln -sfn "$skill" "$link"
          fi
        done
      fi
    done
  fi

  # ALIASES: Aliases always go to the skills/ folder for everyone
  while IFS=$'	' read -r alias_name category canonical_name; do
    [[ -n "$alias_name" && -n "$canonical_name" ]] || continue
    alias_dir="$repo_dir/aliases/$alias_name"
    if [[ ! -f "$alias_dir/SKILL.md" ]]; then
      echo "FAIL alias target missing: $alias_name -> $canonical_name"
      exit 1
    fi
    alias_link="$skills_target/$alias_name"
    ln -sfn "$alias_dir" "$alias_link"
  done < <(python3 - "$repo_dir/catalog.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["skills"]:
    if item["status"] == "promoted":
        for alias in item.get("aliases", []):
            print(f'{alias}	{item["category"]}	{item["name"]}')
PY
)
done

echo "Installed successfully to all platforms (Antigravity Plugins + Legacy Skills) from $repo_dir"
